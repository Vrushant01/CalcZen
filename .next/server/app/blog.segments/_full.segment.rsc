ion":"How accurate is a Calorie Calculator?"}],"toc":[{"id":"heading-0","text":"Supports Healthy Weight Loss","level":3},{"id":"heading-1","text":"Helps Maintain Your Weight","level":3},{"id":"heading-2","text":"Supports Muscle Gain","level":3},{"id":"heading-3","text":"Improves Meal Planning","level":3},{"id":"heading-4","text":"Encourages Better Nutrition Awareness","level":3},{"id":"heading-5","text":"Step 1: Estimate Basal Metabolic Rate (BMR)","level":2},{"id":"heading-6","text":"Step 2: Estimate Total Daily Energy Expenditure (TDEE)","level":2},{"id":"heading-7","text":"Age","level":2},{"id":"heading-8","text":"Sex","level":2},{"id":"heading-9","text":"Height","level":2},{"id":"heading-10","text":"Body Weight","level":2},{"id":"heading-11","text":"Activity Level","level":2},{"id":"heading-12","text":"Body Composition","level":2},{"id":"heading-13","text":"Sedentary","level":3},{"id":"heading-14","text":"Lightly Active","level":3},{"id":"heading-15","text":"Moderately Active","level":3},{"id":"heading-16","text":"Very Active","level":3},{"id":"heading-17","text":"Extremely Active","level":3},{"id":"heading-18","text":"Weight Maintenance","level":2},{"id":"heading-19","text":"Weight Loss","level":2},{"id":"heading-20","text":"Weight Gain","level":2},{"id":"heading-21","text":"Carbohydrate-Rich Foods","level":3},{"id":"heading-22","text":"Protein-Rich Foods","level":3},{"id":"heading-23","text":"Healthy Fat Sources","level":3},{"id":"heading-24","text":"Calorie Deficit vs. Calorie Surplus","level":2},{"id":"heading-25","text":"What Is a Calorie Deficit?","level":3},{"id":"heading-26","text":"What Is a Calorie Surplus?","level":3},{"id":"heading-27","text":"Weight Maintenance","level":3},{"id":"heading-28","text":"Common Calorie Counting Mistakes","level":2},{"id":"heading-29","text":"Underestimating Portion Sizes","level":3},{"id":"heading-30","text":"Forgetting Snacks and Drinks","level":3},{"id":"heading-31","text":"Ignoring Weekends","level":3},{"id":"heading-