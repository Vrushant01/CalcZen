# Database (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Authentication
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=hello@calczen.in
CONTACT_TO=hello@calczen.in

# Site & CORS
SITE_URL=https://www.calczen.in
CORS_ORIGIN=https://www.calczen.in

# Live Metals Rates (All optional except METALS_DEV_API_KEY for the Indian benchmark)
# Provider A: Gold-API.com (live spot rates, no key required)
RATES_API_URL=https://api.gold-api.com
RATES_CACHE_TTL_MINUTES=5

# Provider B: Metals.dev (Authority API for Indian benchmark: IBJA with fallback to MCX)
METALS_DEV_API_KEY=
METALS_DEV_API_URL=https://api.metals.dev
RATES_MULTIPLIER_TTL_HOURS=12
RATES_MONTHLY_CALL_BUDGET=60
RATES_INDIA_PREMIUM_PERCENT=0
