PORT=3001
NODE_ENV=development

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Comma-separated — include your Vercel site URL when frontend is on Vercel
CORS_ORIGIN=http://localhost:8080,https://www.calczen.com,https://YOUR_PROJECT.vercel.app
SITE_URL=https://www.calczen.com
SITE_NAME=CalcZen

RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=hello@calczen.in
EMAIL_BATCH_SIZE=50

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
