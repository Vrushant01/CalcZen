PORT=3001
NODE_ENV=development

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Optional: extra exact origins (comma-separated). Built-in includes:
#   https://calczen.in, https://www.calczen.in, http://localhost:5173
#   plus https://*.vercel.app, http://localhost:*, https://*.calczen.in
CORS_ORIGIN=

SITE_URL=https://www.calczen.com
SITE_NAME=CalcZen

RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=hello@calczen.in
EMAIL_BATCH_SIZE=50

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
