    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "calczen\\.in"
        }
      ],
      "destination": "https://www.calczen.in/:path*",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?calczen\\.in"
        }
      ],
      "destination": "https://admin.calczen.in/:path*",
      "permanent": true
    },
    {
      "source": "/admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "admin\\.calczen\\.in"
        }
      ],
      "destination": "https://admin.calczen.in/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin\\.calczen\\.in"
        }
      ],
      "destination": "https://admin.calczen.in/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/admin",
      "destination": "/api/index.ts"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|admin/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{admin/dist/**,dist/index.html}"
    }
  }
}
